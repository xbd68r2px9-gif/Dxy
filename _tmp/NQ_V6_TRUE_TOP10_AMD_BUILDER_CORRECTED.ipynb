   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# NQ V6 — True Top-10 / AMD (korrigierter Builder)\n",
    "\n",
    "Diese Datei lädt den geprüften V6-Migrationsbuilder, korrigiert die Rangdarstellung im Top-10-Audit und führt ihn vollständig aus. Das Ergebnis wird als `NQ_Specific_Engine_Block_0_1_2_v6_TRUE_TOP10_AMD.ipynb` in Google Drive gespeichert und anschließend heruntergeladen."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, requests\n",
    "from pathlib import Path\n",
    "\n",
    "RAW = 'https://raw.githubusercontent.com/xbd68r2px9-gif/Dxy/main/_tmp/NQ_V6_TRUE_TOP10_AMD_BUILDER.ipynb'\n",
    "response = requests.get(RAW, timeout=60)\n",
    "response.raise_for_status()\n",
    "builder = response.json()\n",
    "\n",
    "for cell in builder.get('cells', []):\n",
    "    if cell.get('cell_type') != 'code':\n",
    "        continue\n",
    "    src = ''.join(cell.get('source', []))\n",
    "    src = src.replace('\\\"Company\\\": \\\"BROADCOM\\\", \\\"Ticker\\\": \\\"AVGO\\\", \\\"CompanyRank\\\": 8', '\\\"Company\\\": \\\"BROADCOM\\\", \\\"Ticker\\\": \\\"AVGO\\\", \\\"CompanyRank\\\": 9')\n",
    "    src = src.replace('\\\"Company\\\": \\\"TESLA\\\", \\\"Ticker\\\": \\\"TSLA\\\", \\\"CompanyRank\\\": 9', '\\\"Company\\\": \\\"TESLA\\\", \\\"Ticker\\\": \\\"TSLA\\\", \\\"CompanyRank\\\": 10')\n",
    "    src = src.replace('\\\"Company\\\": \\\"META\\\", \\\"Ticker\\\": \\\"META\\\", \\\"CompanyRank\\\": 10', '\\\"Company\\\": \\\"META\\\", \\\"Ticker\\\": \\\"META\\\", \\\"CompanyRank\\\": 8')\n",
    "    src = src.replace(\n",
    "        'included_manifest_companies_v6 = set(INDEX_MEMBERSHIP_MANIFEST_V5.query(\\\"StatusAtAsOf.str.startswith(\\\'TOP10_INCLUDED\\\')\\\", engine=\\\'python\\\')[\\\"Company\\\"])',\n",
    "        'included_manifest_companies_v6 = set(INDEX_MEMBERSHIP_MANIFEST_V5.loc[INDEX_MEMBERSHIP_MANIFEST_V5[\\\"StatusAtAsOf\\\"].astype(str).str.startswith(\\\"TOP10_INCLUDED\\\"), \\\"Company\\\"])'\n",
    "    )\n",
    "    cell['source'] = src.splitlines(keepends=True)\n",
    "\n",
    "patched = Path('/content/NQ_V6_TRUE_TOP10_AMD_BUILDER_PATCHED.ipynb')\n",
    "patched.write_text(json.dumps(builder, indent=1, ensure_ascii=False), encoding='utf-8')\n",
    "print('Korrigierter Builder geladen:', patched)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Builderzellen im Colab-Kernel ausführen.\n",
    "ip = get_ipython()\n",
    "for index, cell in enumerate(builder.get('cells', [])):\n",
    "    if cell.get('cell_type') != 'code':\n",
    "        continue\n",
    "    result = ip.run_cell(''.join(cell.get('source', [])))\n",
    "    if getattr(result, 'error_before_exec', None) is not None:\n",
    "        raise result.error_before_exec\n",
    "    if getattr(result, 'error_in_exec', None) is not None:\n",
    "        raise result.error_in_exec\n",
    "print('V6-Builder vollständig ausgeführt.')\n"
   ]
  }
 ],
